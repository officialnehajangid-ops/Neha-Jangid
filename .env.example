# Canonical origin of the deployed site. Used for canonical URLs, Open Graph
# tags, the sitemap and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://nehajangid.com

# Delivery for the contact and "Ask one organic growth question" forms.
# While these are unset the API responds with `email_delivery_not_configured`
# and the form falls back to opening the visitor's mail client, which is how
# the site behaved before it had a backend.
RESEND_API_KEY=
ASK_FORM_FROM_EMAIL=website@nehajangid.com
ASK_FORM_INBOX_EMAIL=hello@nehajangid.com
